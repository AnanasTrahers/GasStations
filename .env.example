# Database Configuration
POSTGRES_USER=my_user
POSTGRES_PASSWORD=my_secure_password
POSTGRES_DB=gasstations_db
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Environment Settings
ENVIRONMENT=production
ALLOWED_HOSTS=["example.com", "www.example.com"]

# API Keys & Third-party Services
MAPBOX_API_KEY=pk.your_mapbox_api_key_here
# GOOGLE_PLAY_SERVICE_ACCOUNT_KEY=your_base64_encoded_key_or_json_path

# Settings (Optional overrides for BusinessSettings)
# FUEL_PRICE_SAFE_DAYS=7
# BUFFER_RADIUS_M=2000
# SEGMENT_LENGTH_M=50000

# Docker Compose / GHCR Variables (Used in deployment)
GHCR_USERNAME=your-github-username
